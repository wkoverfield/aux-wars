{
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "npm install",
  "framework": null,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
      ]
    },
    {
      "source": "/(g|G)/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(lobby|LOBBY|Lobby)/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/(screen|Screen|SCREEN)/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/pro/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/stats",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://aux-wars-production.up.railway.app/api/:path*"
    },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/aux-battle", "destination": "/aux-battle.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/(lobby|LOBBY|Lobby)", "destination": "/app.html" },
    { "source": "/(lobby|LOBBY|Lobby)/(.*)", "destination": "/app.html" },
    { "source": "/(g|G)/(.*)", "destination": "/app.html" },
    { "source": "/(screen|Screen|SCREEN)/(.*)", "destination": "/app.html" },
    { "source": "/pro/(.*)", "destination": "/app.html" },
    { "source": "/stats", "destination": "/app.html" }
  ]
}
